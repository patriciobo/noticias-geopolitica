# Configurá UNA de estas — cmd/ingest elige el proveedor solo, en este
# orden: Claude > Gemini > OpenAI-compatible genérico > Ollama local.

# Opción paga premium
ANTHROPIC_API_KEY=sk-ant-...

# Opción gratis/barata recomendada (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Genérico: cualquier API compatible con OpenAI Chat Completions
# (OpenAI, DeepSeek, etc.) — necesita también BASE_URL y opcionalmente
# los modelos si no son gpt-5-nano.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
# OPENAI_COMPAT_CLASSIFY_MODEL=deepseek-flash
# OPENAI_COMPAT_SYNTHESIZE_MODEL=deepseek-flash

# Sin ninguna key: cae a Ollama local (necesita `ollama serve` corriendo).
